.DS_Store
.idea/

# Dependencies
node_modules/

# Build output
dist/
out/

# TypeScript incremental build info
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
*.log.bak
*.pid

# Local runtime state
.shikishima-memory/
.webhook-cache.json
.agents/other_agent_intro.txt

# Local verification/build snapshots
dist-check/

# Local image drafts; promote through an explicit asset gate only
Note記録用/
３D部屋イメージ/
スタックチャン顔/

# Environment files
.env
.env.*
!.env.example

# WSL2 wrapper — local real values (never commit)
sandbox/hermes-autonomy-zone/local-only/wsl-wrapper-values.local.json
sandbox/hermes-autonomy-zone/local-only/wsl-distro-selection.local.json
.task-start-time.local.txt

# Local-only sandboxes and tool config — never commit
sandbox/
.cursor/
.claude/scripts/
.claude/settings.json
.claude/settings.local.json

# ESLint cache
.eslintcache

# Electron packaging artifacts
release/
.claude/worktrees

# Firmware local build artifacts
docs/firmware/**/.pio/
docs/firmware/*backup*.bin
docs/firmware/*_backup_*.bin
docs/logs/

# Firmware credentials — never commit
docs/firmware/**/credentials.h
docs/firmware/**/sc_credentials.h

# Tauri
**/src-tauri/target/
**/src-tauri/gen/
**/src-tauri/WixTools/

# Python cache
__pycache__/
**/__pycache__/
